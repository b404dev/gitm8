# Example gitm8 config.
# Copy the settings you want into ~/.gitm8/.gitm8rc.
# gitm8 also creates that file automatically on first run when no config exists.

export GITM8_WORKSPACE_DIR="$HOME/Github"
export GITM8_FIRST_RUN_DISMISSED="false"
export GITM8_DEFAULT_BRANCH="main"
export GITM8_EDITOR="vim"
export GITM8_THEME="catppuccin"
export GITM8_CONFIRM_DESTRUCTIVE_ACTIONS="true"
export GITM8_FETCH_ON_STARTUP="false"
export GITM8_SHOW_COMMIT_GRAPH="true"

# matt_mode: always force push with a raw --force when you push, with no
# rejection prompt and no safety net (can clobber remote commits). Off by default.
export GITM8_MATT_MODE="false"

# AI provider used by ctrl+g in the commit prompt and generated PR creation.
# Supported values: codex, claude, ollama
# gitm8 disables AI actions if the configured provider is not installed on PATH.
export GITM8_AI_PROVIDER="codex"
export GITM8_OLLAMA_URL="http://localhost:11434"

# Syslog-style application logs for debugging.
# Supported levels: DEBUG, INFO, WARN, ERROR
export GITM8_LOG_ENABLED="true"
export GITM8_LOG_LEVEL="INFO"
export GITM8_LOG_FILE="$HOME/.gitm8/gitm8.log"
